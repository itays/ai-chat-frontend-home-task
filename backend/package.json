{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scripted WebSocket chat backend on a Cloudflare Worker and Durable Object",
  "type": "module",
  "scripts": {
    "start": "wrangler dev --port 4000",
    "deploy": "wrangler deploy --assets ../frontend/dist",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.161.0"
  }
}
